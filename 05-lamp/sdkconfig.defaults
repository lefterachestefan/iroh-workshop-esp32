# On top of ../sdkconfig.defaults, which all steps share (see Cargo.toml).

# BLE, for WiFi provisioning: NimBLE (what esp32-nimble wraps), not Bluedroid.
# It's off again once a device is provisioned.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# One provisioning client at a time.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# The NimBLE host's heap in PSRAM, like iroh's.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
